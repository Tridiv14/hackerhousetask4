CREATE VERTEX Customer (PRIMARY_ID id STRING, customer_id STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Card (PRIMARY_ID id STRING, card1 STRING, card2 STRING, card3 STRING, card4 STRING, card5 STRING, card6 STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Transaction (PRIMARY_ID id STRING, tx_id STRING, amount DOUBLE, ts STRING, product_cd STRING, channel STRING, risk_score DOUBLE) WITH STATS="OUTDEGREE";
CREATE VERTEX Merchant (PRIMARY_ID id STRING, addr1 STRING, addr2 STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Device (PRIMARY_ID id STRING, device_type STRING, device_info STRING, os STRING, browser STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX IPAddress (PRIMARY_ID id STRING, ip STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX ClosedCase (PRIMARY_ID id STRING, case_id STRING, pattern STRING, outcome STRING, actions STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX InvestigationCase (PRIMARY_ID id STRING, status STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Evidence (PRIMARY_ID id STRING, type STRING, observation STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX EvidenceRequest (PRIMARY_ID id STRING, status STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Action (PRIMARY_ID id STRING, type STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Approval (PRIMARY_ID id STRING, route STRING) WITH STATS="OUTDEGREE";
CREATE VERTEX Outcome (PRIMARY_ID id STRING, verdict STRING) WITH STATS="OUTDEGREE";

CREATE DIRECTED EDGE OWNS_CARD (FROM Customer, TO Card);
CREATE DIRECTED EDGE PERFORMED (FROM Customer, TO Transaction);
CREATE DIRECTED EDGE USED_CARD (FROM Transaction, TO Card);
CREATE DIRECTED EDGE USED_DEVICE (FROM Transaction, TO Device);
CREATE DIRECTED EDGE USED_IP (FROM Transaction, TO IPAddress);
CREATE DIRECTED EDGE TRANSACTED_WITH (FROM Transaction, TO Merchant);
CREATE DIRECTED EDGE INVOLVES_CUSTOMER (FROM ClosedCase, TO Customer);
CREATE DIRECTED EDGE INVOLVES_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE INVOLVES_TRANSACTION (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE INVOLVES_DEVICE (FROM ClosedCase, TO Device);
CREATE DIRECTED EDGE SIMILAR_TO (FROM InvestigationCase, TO ClosedCase, similarity DOUBLE);
CREATE DIRECTED EDGE HAS_EVIDENCE (FROM InvestigationCase, TO Evidence);
CREATE DIRECTED EDGE REQUESTED_EVIDENCE (FROM InvestigationCase, TO EvidenceRequest);
CREATE DIRECTED EDGE PROPOSES_ACTION (FROM InvestigationCase, TO Action);
CREATE DIRECTED EDGE REQUIRES_APPROVAL (FROM Action, TO Approval);
CREATE DIRECTED EDGE RESULTED_IN (FROM InvestigationCase, TO Outcome);

CREATE GRAPH FraudInvestigation(Customer, Card, Transaction, Device, IPAddress, Merchant, ClosedCase, InvestigationCase, Evidence, EvidenceRequest, Action, Approval, Outcome, OWNS_CARD, PERFORMED, USED_CARD, USED_DEVICE, USED_IP, TRANSACTED_WITH, INVOLVES_CUSTOMER, INVOLVES_CARD, INVOLVES_TRANSACTION, INVOLVES_DEVICE, SIMILAR_TO, HAS_EVIDENCE, REQUESTED_EVIDENCE, PROPOSES_ACTION, REQUIRES_APPROVAL, RESULTED_IN);

