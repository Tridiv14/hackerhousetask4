# Autonomous Fraud Investigation AI System Environment Configuration

# LLM API Keys (Set at least one of these to enable LLM reasoning)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Model Selections (Defaults will be used if left empty)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# TigerGraph Connection Credentials (Optional - Mock fallback active if not configured)
TG_HOST=http://localhost:9000
TG_GRAPH=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_SECRET=
